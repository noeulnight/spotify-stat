FROM node:26.12.0-alpine AS builder

WORKDIR /app
RUN npm install -g pnpm@11.9.0

COPY package.json pnpm-lock.yaml pnpm-workspace.yaml ./
COPY apps/client/package.json ./apps/client/package.json
RUN CI=true pnpm --filter spotistat... install --frozen-lockfile

COPY apps/client ./apps/client
ARG PUBLIC_API_BASE_URL=http://127.0.0.1:8080
ARG SITE_URL=http://127.0.0.1:3000
ENV PUBLIC_API_BASE_URL=${PUBLIC_API_BASE_URL} SITE_URL=${SITE_URL}
WORKDIR /app/apps/client
RUN pnpm typecheck && pnpm build
RUN CI=true pnpm --filter spotistat... install --prod --frozen-lockfile

FROM node:26.12.0-alpine

WORKDIR /app/apps/client
ENV NODE_ENV=production HOST=0.0.0.0 PORT=3000
COPY --from=builder /app/node_modules /app/node_modules
COPY --from=builder /app/apps/client/node_modules ./node_modules
COPY --from=builder /app/apps/client/dist ./dist
EXPOSE 3000
CMD ["node", "dist/server/entry.mjs"]
