---
import { PageSkeleton } from "../../shared/ui/page-skeleton";
import AppLayout from "../../layouts/AppLayout.astro";
import { TopArtistsTable } from "../../widgets/top-artists";
---

<AppLayout title="Top artists · Spotistat">
  <section aria-labelledby="top-artists-title" class="space-y-4">
    <h1 id="top-artists-title" class="text-2xl font-semibold tracking-tight">
      Top artists
    </h1>
    <div class="min-w-0">
      <TopArtistsTable client:only="react">
        <PageSkeleton slot="fallback" layout="table" columns={3} />
      </TopArtistsTable>
    </div>
  </section>
</AppLayout>
