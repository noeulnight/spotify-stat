---
import { PageSkeleton } from "../../../../shared/ui/page-skeleton";
import AppLayout from "../../../../layouts/AppLayout.astro";
import { TopArtistsTable } from "../../../../widgets/top-artists";

export const prerender = false;
const publicToken = Astro.params.token!;
---

<AppLayout title="Top artists · Spotistat" publicToken={publicToken}>
  <section aria-labelledby="top-artists-title" class="space-y-4">
    <h1 id="top-artists-title" class="text-2xl font-semibold tracking-tight">
      Top artists
    </h1>
    <div class="min-w-0">
      <TopArtistsTable publicToken={publicToken} client:only="react">
        <PageSkeleton slot="fallback" layout="table" columns={3} />
      </TopArtistsTable>
    </div>
  </section>
</AppLayout>
