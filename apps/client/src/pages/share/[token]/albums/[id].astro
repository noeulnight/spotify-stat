---
import { PageSkeleton } from "../../../../shared/ui/page-skeleton";
import AppLayout from "../../../../layouts/AppLayout.astro";
import { AlbumDetails } from "../../../../widgets/album-details";

export const prerender = false;
const id = Astro.params.id!;
const publicToken = Astro.params.token!;
---

<AppLayout social={{ kind: "albums", id }} publicToken={publicToken}>
  <section>
    <AlbumDetails id={id} publicToken={publicToken} client:only="react">
      <PageSkeleton slot="fallback" layout="detail" columns={3} />
    </AlbumDetails>
  </section>
</AppLayout>
