---
import AppLayout from "../../../layouts/AppLayout.astro";
import { NowPlaying } from "../../../widgets/now-playing";
import { PageSkeleton } from "../../../shared/ui/page-skeleton";

export const prerender = false;
const publicToken = Astro.params.token!;
---

<AppLayout title="Now playing · Spotistat" publicToken={publicToken}>
  <section
    class="-mt-2 flex h-[calc(100dvh-5.5rem)] min-h-80 flex-col md:h-[calc(100dvh-6.5rem)]"
    aria-label="Now playing"
  >
    <NowPlaying publicToken={publicToken} client:only="react">
      <PageSkeleton slot="fallback" layout="detail" />
    </NowPlaying>
  </section>
</AppLayout>
