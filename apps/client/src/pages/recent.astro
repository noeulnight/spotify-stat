---
import AppLayout from "../layouts/AppLayout.astro";
import { RecentTracks } from "../widgets/recent-tracks";
import { PageSkeleton } from "../shared/ui/page-skeleton";
---

<AppLayout title="Recent · Spotistat">
  <section aria-labelledby="recent-title" class="space-y-4">
    <h1 id="recent-title" class="text-2xl font-semibold tracking-tight">
      Recent
    </h1>
    <RecentTracks client:only="react">
      <PageSkeleton slot="fallback" columns={2} />
    </RecentTracks>
  </section>
</AppLayout>
